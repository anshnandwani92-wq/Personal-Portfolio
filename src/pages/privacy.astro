---
import SiteLayout from '../layouts/SiteLayout.astro';
export const prerender = true;
---
<SiteLayout title="Privacy | AI, Data and Martech Consultant" description="Privacy information for the AI, Data and Martech Consultant website." path="/privacy">
  <section class="page-hero container"><div class="eyebrow">Privacy</div><h1>Your information stays yours.</h1><p>This site does not use advertising trackers or sell personal information.</p></section>
  <section class="section-tight container prose-block"><h2>Contact enquiries</h2><p>The enquiry form opens a draft in your email application. This website does not store the information you enter. Your email provider handles the message after you choose to send it.</p><h2>Site analytics</h2><p>No third-party analytics or advertising cookies are configured. The site exposes a small set of conversion events for a future privacy-friendly analytics provider; no analytics provider is active by default.</p><h2>Questions</h2><p>Use the contact page to ask about this notice.</p><a class="button button-primary" href="/contact">Contact Ansh <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
