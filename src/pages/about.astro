---
import SiteLayout from '../layouts/SiteLayout.astro';
export const prerender = true;
const strengths = [
  { title: 'Marketing sense', copy: 'An MBA in Marketing and experience across brand, agency media and enterprise marketing technology help connect platform decisions to customer and business needs.' },
  { title: 'Hands-on delivery', copy: 'I work across strategy and implementation, including customer data models, tags, experiments and front-end experiences.' },
  { title: 'AI for real workflows', copy: 'I build and advise on AI agents and proof-of-concept work, with attention to governance, adoption and a clear handoff.' },
];
const roles = [
  { period: '2024 — present', title: 'Personalization Strategy Lead · Marketing Technology & Data Products Manager', company: 'Enterprise financial services' },
  { period: '2022 — 2024', title: 'Manager, Data and Marketing Technology', company: 'Sports and media' },
  { period: '2021 — 2022', title: 'Digital Strategy Lead · Digital Strategist', company: 'Global agency' },
  { period: '2020 — 2021', title: 'Digital Strategist', company: 'Digital agency' },
  { period: '2018 — 2019', title: 'Brand Manager', company: 'Automotive' },
];
---
<SiteLayout title="About Ansh Nandwani | AI, Personalization & Martech" description="Meet Ansh Nandwani, a Toronto-based marketing technology and personalization leader working across strategy, data and delivery." path="/about">
  <section class="page-hero container"><h1>Marketing strategy grounded in building.</h1><p>I lead personalization and marketing technology work, connecting customer data with the experiences people use. Before focusing on enterprise martech, I built media products and led digital strategy in agency teams. I’m based in Toronto and work with teams in Canada and the U.S.</p></section>
  <section class="section-tight container"><div class="section-heading"><div><h2>What I bring to the work.</h2></div><p>Commercial context, technical detail and a practical route to delivery.</p></div><div class="approach-grid"><article class="card approach-card"><h3>{strengths[0].title}</h3><p>{strengths[0].copy}</p></article><article class="card approach-card"><h3>{strengths[1].title}</h3><p>{strengths[1].copy}</p></article><article class="card approach-card"><h3>{strengths[2].title}</h3><p>{strengths[2].copy}</p></article></div></section>
  <section class="section container"><div class="section-heading"><div><h2>Experience across marketing, media and data.</h2></div><p>Employer names are omitted while publishing permissions are being confirmed.</p></div><div class="timeline">{roles.map((role) => <div class="timeline-item"><span>{role.period}</span><div><h3>{role.title}</h3><p>{role.company}</p></div></div>)}</div></section>
  <section class="section-tight container"><div class="about-credentials"><div><h2>Education</h2><ul><li>MBA, Marketing · NMIMS, Mumbai · 2014–2015</li><li>B.Tech, Information Technology · NMIMS, Mumbai · 2010–2014</li><li>Artificial Intelligence Certificate · BrainStation · 2023</li></ul></div><div><h2>Platforms and tools</h2><p><strong>Marketing technology:</strong> Salesforce Marketing Cloud Personalization, Salesforce CRM, Financial Services Cloud, Data 360, Agentforce, Adobe Experience Platform, Adobe Target, Adobe Experience Manager and Google Ad Manager.</p><p><strong>Data and AI:</strong> Python, SQL, TensorFlow, Databricks, Snowflake, Amazon Bedrock, DOMO and Power BI.</p><p><strong>Engineering:</strong> JavaScript, React and Next.js.</p></div></div></section>
  <section class="section container"><div class="cta-panel"><h2>Have a marketing or data challenge in mind?</h2><p>Tell me what you’re trying to improve and we can work out where to begin.</p><a class="button button-primary book-link" href="/contact#booking" data-track="book_call_click">Book a call <span aria-hidden="true">↗</span></a></div></section>
</SiteLayout>
