---
import SiteLayout from '../layouts/SiteLayout.astro';
import { serviceLanes } from '../lib/service-lanes';
export const prerender = true;
const approach = [
  { title: 'Audit the work', copy: 'Clarify the marketing goal, current tools and points where teams lose time or useful signals.' },
  { title: 'Fix the foundation', copy: 'Address the tags, identity, data model and operating decisions the work depends on.' },
  { title: 'Launch personalization', copy: 'Build and test relevant customer experiences across campaigns and digital journeys.' },
  { title: 'Automate and hand over', copy: 'Use AI where it helps, document how it works and give the team a path to keep improving it.' },
];
---
<SiteLayout title="Ansh Nandwani | AI, Personalization & Martech Consultant" description="I help marketing teams connect customer data, scale personalization and put AI to work across Salesforce, Adobe and modern data platforms." path="">
  <section class="hero">
    <div class="container hero-inner">
      <h1>I help marketing teams scale personalization and make <em>AI useful.</em></h1>
      <p class="hero-copy">I connect customer data, CRM and personalization tools so teams can deliver more relevant experiences and spend less time on manual work. My work spans enterprise marketing, media products and agency strategy.</p>
      <div class="hero-actions"><a class="button button-primary book-link" href="/contact#booking" data-track="book_call_click">Book a call <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="#results">See the results <span aria-hidden="true">↓</span></a></div>
      <div class="hero-profile">
        <img class="hero-profile-photo" src="/ansh-nandwani.jpeg" alt="Ansh Nandwani" width="68" height="68" fetchpriority="high" />
        <div class="hero-profile-copy">
          <strong>Ansh Nandwani</strong>
          <span>Independent AI, data &amp; martech consultant</span>
          <a class="hero-social-link" href="https://www.linkedin.com/in/ansh-nandwani/" target="_blank" rel="noopener noreferrer" aria-label="Connect with Ansh Nandwani on LinkedIn">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-meta"><span>Toronto · Canada + U.S.</span><span>Personalization · Data · AI</span></div>
    </div>
    <aside class="hero-visual" data-flow-visual data-active="signals" aria-labelledby="flow-visual-title">
      <div class="flow-visual-heading">
        <h2 id="flow-visual-title">From customer signal to better marketing.</h2>
        <span class="flow-figure">SELECT A STAGE</span>
      </div>
      <div class="flow-canvas">
        <svg class="flow-routes" viewBox="0 0 800 230" preserveAspectRatio="none" aria-hidden="true">
          <defs><marker id="flow-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 8 4 0 8Z" /></marker></defs>
          <path class="flow-segment" data-segment="signals-decisions" d="M105 124H291" marker-end="url(#flow-arrow)" />
          <path class="flow-segment" data-segment="decisions-activation" d="M307 124H493" marker-end="url(#flow-arrow)" />
          <path class="flow-segment" data-segment="activation-measurement" d="M509 124H695" marker-end="url(#flow-arrow)" />
        </svg>
        <div class="flow-stage-grid" role="group" aria-label="Select a stage in the illustrative marketing workflow">
          <button class="flow-node" type="button" data-flow-node="signals" aria-pressed="true" aria-describedby="flow-detail-copy">
            <span class="flow-node-index">INPUT</span><strong>Customer signals</strong><span class="flow-node-caption">Identity · behavior</span>
          </button>
          <button class="flow-node" type="button" data-flow-node="decisions" aria-pressed="false" aria-describedby="flow-detail-copy">
            <span class="flow-node-index">DECIDE</span><strong>Strategy + AI</strong><span class="flow-node-caption">Focus · next action</span>
          </button>
          <button class="flow-node" type="button" data-flow-node="activation" aria-pressed="false" aria-describedby="flow-detail-copy">
            <span class="flow-node-index">ACTIVATE</span><strong>Campaigns + journeys</strong><span class="flow-node-caption">Paid · CRM · web</span>
          </button>
          <button class="flow-node" type="button" data-flow-node="measurement" aria-pressed="false" aria-describedby="flow-detail-copy">
            <span class="flow-node-index">LEARN</span><strong>Measurement</strong><span class="flow-node-caption">Results · next step</span>
          </button>
        </div>
        <p class="flow-feedback-label"><span aria-hidden="true">←</span> Measurement informs the next decision</p>
      </div>
      <div class="flow-detail" aria-live="polite" aria-atomic="true">
        <span class="flow-detail-mark" aria-hidden="true">01</span>
        <div><strong data-flow-detail-title>Customer signals</strong><p id="flow-detail-copy" data-flow-detail-copy>Bring customer identity, behavior, CRM and campaign signals into the same conversation.</p></div>
      </div>
      <p class="flow-hint">Hover, focus or select a stage to see what changes.</p>
    </aside>
  </section>

  <div class="trust-strip" aria-label="Selected results"><div class="container proof-strip"><span><strong>CAD $30M</strong> first-year product revenue</span><span><strong>120%+</strong> fill-rate lift</span><span>Near-real-time media and sales measurement</span></div></div>

  <section class="section container" id="services" data-reveal>
    <div class="section-heading"><div><h2>Four ways to make marketing work better.</h2></div><p>For marketing, CRM and data leaders, and the agency teams that help them move.</p></div>
    <div class="service-grid">{serviceLanes.map((service) => <a class="card service-card" href={`/services/${service.slug}`} data-spotlight><h3>{service.title}</h3><p>{service.intro}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="section container" id="results" data-reveal>
    <div class="section-heading"><div><h2>Results a marketer can understand.</h2></div><p>Selected outcomes from product, media and customer data work.</p></div>
    <div class="proof-grid">
      <article class="card proof-card"><div class="proof-number">CAD $30M</div><p class="proof-caption">First-year revenue from a cross-channel planning and measurement product.</p></article>
      <article class="card proof-card"><div class="proof-number">120%+</div><p class="proof-caption">Fill-rate lift after introducing custom campaign pacing curves with ad-serving partners.</p></article>
      <article class="card proof-card proof-card-qualitative"><div class="proof-number">Near real time</div><p class="proof-caption">Media, sales and store-visit data brought together for better campaign planning and attribution.</p></article>
    </div>
    <p class="proof-note">Employer and client details are kept private. Results are presented as described in the source materials.</p>
  </section>

  <section class="section container" id="approach" data-reveal>
    <div class="section-heading"><div><h2>Start with the foundation. Scale what works.</h2></div><p>Every engagement is shaped around the question, the systems and the team doing the work.</p></div>
    <div class="approach-grid approach-grid-four">{approach.map((step, index) => <article class="card approach-card"><span class="card-index">0{index + 1} · {['Audit', 'Foundation', 'Launch', 'Handoff'][index]}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}</div>
  </section>

  <section class="section container" data-reveal><div class="cta-panel"><h2>Tell me your goal. I’ll help you find where to start.</h2><p>Share what you’re trying to improve and what is getting in the way. We can shape a useful first step together.</p><a class="button button-primary book-link" href="/contact#booking" data-track="book_call_click">Book a call <span aria-hidden="true">↗</span></a></div></section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
        card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
      });
    });

    const flowVisual = document.querySelector<HTMLElement>('[data-flow-visual]');
    const flowTitle = flowVisual?.querySelector<HTMLElement>('[data-flow-detail-title]');
    const flowCopy = flowVisual?.querySelector<HTMLElement>('[data-flow-detail-copy]');
    const flowMark = flowVisual?.querySelector<HTMLElement>('.flow-detail-mark');
    const flowStages = [
      { id: 'signals', title: 'Customer signals', copy: 'Bring customer identity, behavior, CRM and campaign signals into the same conversation.' },
      { id: 'decisions', title: 'Strategy + AI', copy: 'Choose a customer or business need, then use data and AI to shape a focused next action.' },
      { id: 'activation', title: 'Campaigns + journeys', copy: 'Put the plan into practice across paid media, CRM, email, SMS and web experiences.' },
      { id: 'measurement', title: 'Measurement', copy: 'Read what changed and use the result to shape the next decision.' },
    ];
    const activateFlowStage = (stageId: string) => {
      const stage = flowStages.find((item) => item.id === stageId);
      if (!stage || !flowVisual || !flowTitle || !flowCopy || !flowMark) return;
      flowVisual.dataset.active = stage.id;
      flowMark.textContent = `0${flowStages.indexOf(stage) + 1}`;
      flowTitle.textContent = stage.title;
      flowCopy.textContent = stage.copy;
      flowVisual.querySelectorAll<HTMLButtonElement>('[data-flow-node]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.flowNode === stage.id));
      });
    };
    flowVisual?.querySelectorAll<HTMLButtonElement>('[data-flow-node]').forEach((button) => {
      button.addEventListener('pointerenter', () => activateFlowStage(button.dataset.flowNode ?? ''));
      button.addEventListener('focus', () => activateFlowStage(button.dataset.flowNode ?? ''));
      button.addEventListener('click', () => activateFlowStage(button.dataset.flowNode ?? ''));
    });
  </script>
</SiteLayout>
