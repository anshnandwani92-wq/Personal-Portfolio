---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { serviceLanes } from '../../lib/service-lanes';
export const prerender = true;
---
<SiteLayout title="Services | Ansh Nandwani" description="Personalization, customer data, CRM, AI automation and martech audit support for marketing teams." path="/services">
  <section class="page-hero container"><h1>Make the tools you have work harder.</h1><p>Four focused ways to connect customer data, improve personalization and put AI to work across marketing.</p></section>
  <section class="section-tight container"><div class="service-grid">{serviceLanes.map((lane) => <a class="card service-card" href={`/services/${lane.slug}`} data-spotlight><h2>{lane.title}</h2><p>{lane.intro}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section container"><div class="section-heading"><div><h2>Start with the question, then build the answer.</h2></div><p>The scope follows the goal, the systems already in place and the people who will own the work.</p></div><div class="approach-grid approach-grid-four"><article class="card approach-card"><h3>Audit the work</h3><p>Clarify the goal, data, platforms and workflow friction.</p></article><article class="card approach-card"><h3>Fix the foundation</h3><p>Resolve the tags, identity and operating decisions the work depends on.</p></article><article class="card approach-card"><h3>Launch and learn</h3><p>Test personalization or automation against a clear business question.</p></article><article class="card approach-card"><h3>Hand over</h3><p>Document the system and leave the team with a practical next step.</p></article></div></section>
  <section class="section container"><div class="cta-panel"><h2>Tell me your goal. I’ll help you find the first useful step.</h2><a class="button button-primary book-link" href="/contact#booking" data-track="book_call_click">Book a call <span aria-hidden="true">↗</span></a></div></section>
</SiteLayout>
